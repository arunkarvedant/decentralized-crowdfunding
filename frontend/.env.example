# JSON-RPC endpoint for contract reads (defaults to local Hardhat node)
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Supported chain ID: 31337 (Hardhat local), 11155111 (Sepolia)
NEXT_PUBLIC_CHAIN_ID=31337

# Optional: WalletConnect Cloud project ID (v2)
NEXT_PUBLIC_WC_PROJECT_ID=

# Server-side Pinata JWT for pinning campaign metadata & cover images to IPFS
PINATA_JWT=

# Optional: Public site URL for metadata/sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
